{
  "name": "@chip-city/production-spec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "validate": "tsx src/cli.ts validate",
    "compile": "tsx src/cli.ts compile",
    "export": "tsx src/cli.ts export",
    "export:docs-proof-v1": "tsx src/cli.ts export-docs-proof-v1",
    "validate:docs-proof-v1": "tsx src/cli.ts validate-docs-proof-v1",
    "clean": "tsx src/cli.ts clean",
    "generate:packet": "tsx src/cli.ts generate-packet",
    "validate:packet": "tsx src/cli.ts validate-packet"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
