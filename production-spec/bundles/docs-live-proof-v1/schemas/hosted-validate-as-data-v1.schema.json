{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chip-city.dev/docs-live-proof/hosted-validate-as-data-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "protocol_id", "proof_bundle_digest", "proof_contract_revision", "proof_verification_revision", "target_repository", "target_base_ref", "target_base_sha", "candidate_head_sha", "workflow_id", "workflow_repository", "workflow_name", "workflow_path", "workflow_blob_sha", "trusted_log_attestation_digest", "run_id", "run_attempt", "check_suite_id", "check_run_id", "job", "check_name", "conclusion", "event", "app_id", "app_slug", "producer", "evaluator", "produced_observation", "evaluated_observation", "raw_facts", "semantic_verdict", "evidence_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"const": "docs-live-proof-hosted-validate-as-data-v1"},
    "protocol_id": {"const": "docs-live-proof-v1"},
    "proof_bundle_digest": {"$ref": "#/$defs/digest"},
    "proof_contract_revision": {"$ref": "#/$defs/digest"},
    "proof_verification_revision": {"$ref": "#/$defs/digest"},
    "target_repository": {"const": "kaimihata/silicon-game-v1"},
    "target_base_ref": {"const": "refs/heads/develop"},
    "target_base_sha": {"$ref": "#/$defs/sha"},
    "candidate_head_sha": {"$ref": "#/$defs/sha"},
    "workflow_id": {"const": 349570522},
    "workflow_repository": {"const": "kaimihata/silicon-game-v1"},
    "workflow_name": {"const": "Data-only runner contract validation"},
    "workflow_path": {"const": ".github/workflows/runner-contract-validation.yml"},
    "workflow_blob_sha": {"const": "0f66a20943fb86f3cd1bd821aa490fa9716ef0af"},
    "trusted_log_attestation_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "check_suite_id": {"type": "integer", "minimum": 1},
    "check_run_id": {"type": "integer", "minimum": 1},
    "job": {"const": "validate-as-data"},
    "check_name": {"const": "validate-as-data"},
    "conclusion": {"const": "success"},
    "event": {"const": "pull_request_target"},
    "app_id": {"const": 15368},
    "app_slug": {"const": "github-actions"},
    "producer": {"$ref": "#/$defs/identity"},
    "evaluator": {"$ref": "#/$defs/identity"},
    "produced_observation": {"$ref": "#/$defs/observation"},
    "evaluated_observation": {"$ref": "#/$defs/observation"},
    "raw_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_attempt", "job", "candidate_sha", "pr_ref", "base_ref", "workflow_sha", "trusted_controller_sha", "fetch_head_sha", "workflow_sha_source", "workflow_sha_matches_trusted_controller", "trusted_controller_distinct_from_candidate", "fetch_head_matches_candidate", "validator_command", "validated_without_candidate_execution"],
      "properties": {
        "run_attempt": {"type": "integer", "minimum": 1},
        "job": {"const": "validate-as-data"},
        "candidate_sha": {"$ref": "#/$defs/sha"},
        "pr_ref": {"type": "string", "pattern": "^refs/pull/[1-9][0-9]*/head$"},
        "base_ref": {"const": "develop"},
        "workflow_sha": {"$ref": "#/$defs/sha"},
        "trusted_controller_sha": {"$ref": "#/$defs/sha"},
        "fetch_head_sha": {"$ref": "#/$defs/sha"},
        "workflow_sha_source": {"const": "authenticated_trusted_log_attestation"},
        "workflow_sha_matches_trusted_controller": {"const": true},
        "trusted_controller_distinct_from_candidate": {"const": true},
        "fetch_head_matches_candidate": {"const": true},
        "validator_command": {"const": "python3 scripts/static_candidate_validator.py --trusted-sha \"$TRUSTED_CONTROLLER_SHA\" --candidate-sha \"$CANDIDATE_SHA\""},
        "validated_without_candidate_execution": {"const": true}
      }
    },
    "semantic_verdict": {"$ref": "#/$defs/verdict"},
    "evidence_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_ref_sha", "head_sha", "observed_at"],
      "properties": {
        "base_ref_sha": {"$ref": "#/$defs/sha"},
        "head_sha": {"$ref": "#/$defs/sha"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "bindings_match", "immutable_identity_complete", "fresh", "producer_evaluator_independent"],
      "properties": {
        "status": {"const": "passed"},
        "bindings_match": {"const": true},
        "immutable_identity_complete": {"const": true},
        "fresh": {"const": true},
        "producer_evaluator_independent": {"const": true}
      }
    }
  }
}
