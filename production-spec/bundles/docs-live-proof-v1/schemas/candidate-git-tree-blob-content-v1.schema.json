{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chip-city.dev/docs-live-proof/candidate-git-tree-blob-content-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "protocol_id", "proof_bundle_digest", "proof_contract_revision", "proof_verification_revision", "target_repository", "target_base_ref", "target_base_sha", "candidate_head_sha", "path", "change_kind", "mode", "blob_object_id", "bytes_sha256", "bytes", "encoding", "final_newline", "producer", "evaluator", "produced_observation", "evaluated_observation", "raw_facts", "semantic_verdict", "evidence_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"const": "docs-live-proof-candidate-git-tree-blob-content-v1"},
    "protocol_id": {"const": "docs-live-proof-v1"},
    "proof_bundle_digest": {"$ref": "#/$defs/digest"},
    "proof_contract_revision": {"$ref": "#/$defs/digest"},
    "proof_verification_revision": {"$ref": "#/$defs/digest"},
    "target_repository": {"const": "kaimihata/silicon-game-v1"},
    "target_base_ref": {"const": "refs/heads/develop"},
    "target_base_sha": {"$ref": "#/$defs/sha"},
    "candidate_head_sha": {"$ref": "#/$defs/sha"},
    "path": {"const": "docs/live-proof.md"},
    "change_kind": {"const": "add"},
    "mode": {"const": "100644"},
    "blob_object_id": {"const": "74a349837fcb7e1f8d6fb8cdb015089c66edadce"},
    "bytes_sha256": {"const": "sha256:1c3cc393ba4b6269bfda95738934ec933990133120dfec373c9e0e1c17959e13"},
    "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "encoding": {"const": "UTF-8"},
    "final_newline": {"const": true},
    "producer": {"$ref": "#/$defs/identity"},
    "evaluator": {"$ref": "#/$defs/identity"},
    "produced_observation": {"$ref": "#/$defs/observation"},
    "evaluated_observation": {"$ref": "#/$defs/observation"},
    "raw_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_path_count", "added_paths", "modified_paths", "deleted_paths", "renamed_paths", "copied_paths"],
      "properties": {
        "changed_path_count": {"const": 1},
        "added_paths": {"const": ["docs/live-proof.md"]},
        "modified_paths": {"const": []},
        "deleted_paths": {"const": []},
        "renamed_paths": {"const": []},
        "copied_paths": {"const": []}
      }
    },
    "semantic_verdict": {"$ref": "#/$defs/verdict"},
    "evidence_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_ref_sha", "head_sha", "observed_at"],
      "properties": {
        "base_ref_sha": {"$ref": "#/$defs/sha"},
        "head_sha": {"$ref": "#/$defs/sha"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "bindings_match", "content_matches", "immutable_identity_complete", "fresh", "producer_evaluator_independent"],
      "properties": {
        "status": {"const": "passed"},
        "bindings_match": {"const": true},
        "content_matches": {"const": true},
        "immutable_identity_complete": {"const": true},
        "fresh": {"const": true},
        "producer_evaluator_independent": {"const": true}
      }
    }
  }
}
