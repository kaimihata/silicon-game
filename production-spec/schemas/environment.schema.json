{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chip-city.dev/production-spec/environment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "platform", "runner", "hardware", "software", "purpose"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "ready"]},
    "platform": {"enum": ["windows-x86_64", "macos-universal", "headless"]},
    "runner": {"enum": ["factory-self-hosted", "github-hosted", "developer-local"]},
    "hardware": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "software": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "purpose": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128}}
}
