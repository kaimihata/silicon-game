{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chip-city.dev/production-spec/specification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "title", "summary", "milestones", "sources", "parameters", "rules", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "ready"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "milestones": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {"type": "string", "pattern": "^(docs/|content/|schemas/|engine\\.js|verification\\.test\\.js)"},
          "role": {"enum": ["authority", "provisional_values", "validated_spike_behavior", "context"]}
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "value": {"type": ["string", "number", "integer", "boolean"]},
          "unit": {"type": "string", "minLength": 1},
          "provisional": {"type": "boolean"}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "level", "acceptance_notes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1},
          "level": {"enum": ["normative", "guidance"]},
          "acceptance_notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "choice", "rationale", "supersedes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "choice": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "supersedes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128}
  }
}
