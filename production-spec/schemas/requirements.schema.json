{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chip-city.dev/production-spec/requirements.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "status", "milestones", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "ready"]},
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "owner", "depends_on", "checkpoint_required"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "owner": {"$ref": "#/$defs/id"},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "checkpoint_required": {"type": "boolean"}
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "priority", "lifecycle", "source", "acceptance"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1},
          "priority": {"enum": ["must", "should", "could"]},
          "lifecycle": {"enum": ["milestone", "post_checkpoint_transition"]},
          "milestone": {"$ref": "#/$defs/id"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["specification", "rule"],
            "properties": {
              "specification": {"$ref": "#/$defs/id"},
              "rule": {"$ref": "#/$defs/id"}
            }
          },
          "linked_sources": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/source"}
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["check_id", "type", "suite"],
              "properties": {
                "check_id": {"$ref": "#/$defs/id"},
                "type": {"enum": ["schema", "static_check", "automated_test", "property_test", "integration_test", "semantic_scenario", "black_box_scenario", "performance_measurement", "asset_validation", "human_review"]},
                "suite": {"$ref": "#/$defs/id"},
                "scenario": {"$ref": "#/$defs/id"}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"lifecycle": {"const": "milestone"}}},
            "then": {"required": ["milestone"]},
            "else": {"not": {"required": ["milestone"]}}
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specification", "rule"],
      "properties": {
        "specification": {"$ref": "#/$defs/id"},
        "rule": {"$ref": "#/$defs/id"}
      }
    }
  }
}
