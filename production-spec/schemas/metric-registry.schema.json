{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chip-city.dev/production-spec/metric-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "kind", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"const": "metrics"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "ready"]},
    "kind": {"const": "metrics"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "value_type", "unit", "definition", "sources", "aggregation", "window"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "pattern": "^[^/].*"},
          "value_type": {"enum": ["integer", "number"]},
          "unit": {"enum": ["milliseconds", "seconds", "bytes", "kilobytes", "megabytes", "frames_per_second", "requests_per_second", "percent", "count"]},
          "definition": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "aggregation": {"enum": ["identity", "count", "sum", "maximum", "minimum", "mean", "percentile_95", "ratio_percent"]},
          "window": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128}}
}
