{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chip-city.dev/production-spec/bundle-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "version", "status", "source_repository", "factory_repository", "target_repository", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"const": "chip-city-production-foundation"},
    "version": {"type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "ready"]},
    "source_repository": {"const": "kaimihata/silicon-game"},
    "factory_repository": {"const": "kaimihata/silicon-code-factory"},
    "target_repository": {"const": "kaimihata/silicon-game-v1"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "schema"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/].+\\.yaml$"},
          "kind": {"enum": ["specification", "catalog", "fixture", "requirements", "scenario", "environment", "registry", "verification_plan", "policy", "packet_config", "target_bootstrap"]},
          "schema": {"type": "string", "pattern": "^schemas/[A-Za-z0-9][A-Za-z0-9._-]*\\.schema\\.json$"}
        }
      }
    }
  }
}
