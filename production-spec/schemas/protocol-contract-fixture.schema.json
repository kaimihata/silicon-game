{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chip-city.dev/production-spec/protocol-contract-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "request_defaults", "request_cases", "responses"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"const": "player-protocol-v1-contract"},
    "version": {"const": 1},
    "status": {"enum": ["draft", "ready"]},
    "request_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "actor_id", "agent_test_profile_id", "expected_command_revision"],
      "properties": {
        "protocol_version": {"const": 1},
        "actor_id": {"type": "string"},
        "agent_test_profile_id": {"type": "string"},
        "expected_command_revision": {"type": "integer", "minimum": 0}
      }
    },
    "request_cases": {
      "type": "array",
      "minItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "action", "arguments"],
        "properties": {
          "command_id": {"type": "string"},
          "action": {"type": "string"},
          "arguments": {"type": "object"}
        }
      }
    },
    "responses": {"type": "array", "minItems": 2, "items": {"type": "object"}}
  }
}
