{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chip-city.dev/production-spec/verification-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "suites", "runner_contracts", "fixtures", "scenario_assertions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"const": "chip-city-verification-plan"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "ready"]},
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runner_contracts"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "runner_contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "runner_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command_id", "unavailable"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "command_id": {"$ref": "#/$defs/id"},
          "unavailable": {"const": "fail_closed"}
        }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "setup_contract", "state_assertions"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "setup_contract": {"$ref": "#/$defs/id"},
          "state_assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "source", "operator", "value"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "source": {"$ref": "#/$defs/id"},
                "operator": {"const": "equal"},
                "value": {"type": ["string", "number", "boolean"]}
              }
            }
          }
        }
      }
    },
    "scenario_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scenario", "kind", "evaluator", "required_evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "scenario": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["goal", "invariant", "required_behavior"]},
          "metric": {"$ref": "#/$defs/id"},
          "operator": {"enum": ["equal", "not_equal", "less_than", "less_than_or_equal", "greater_than", "greater_than_or_equal"]},
          "value": {"type": "number"},
          "runner_contract": {"$ref": "#/$defs/id"},
          "evaluator": {"$ref": "#/$defs/id"},
          "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "goal"}}},
            "then": {"required": ["metric", "operator", "value"]},
            "else": {"required": ["runner_contract"]}
          }
        ]
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128}}
}
